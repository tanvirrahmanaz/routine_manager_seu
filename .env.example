# Connecting an Upstash Redis store from the Vercel dashboard (Storage tab)
# sets these two automatically in Production, Preview and Development.
# For local `vercel dev`, run `vercel env pull .env.local` to fetch them.

KV_REST_API_URL="https://xxxxx.upstash.io"
KV_REST_API_TOKEN="your-upstash-rest-token"

# A database created directly on upstash.com uses these names instead;
# both pairs are supported.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Optional. If set, editing the routine requires this password.
# Leave it out entirely and anyone who can open the site can edit.
ADMIN_KEY=""
