# Copy to .env.local for `vercel dev`, and set the same values in
# Vercel -> Project -> Settings -> Environment Variables for production.

# MongoDB Atlas connection string (required)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Optional overrides
MONGODB_DB="seu_law_routine"
MONGODB_COLLECTION="routine_store"

# Optional. If set, editing the routine requires this password.
# Leave it out entirely and anyone who can open the site can edit.
ADMIN_KEY=""
